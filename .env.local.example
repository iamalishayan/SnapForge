# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI APIs
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# Vercel ISR revalidation secret
REVALIDATION_SECRET=your_random_secret_here

# Email alerts
RESEND_API_KEY=re_...
ALERT_EMAIL=your@email.com

# IndexNow
INDEXNOW_KEY=your_indexnow_key

# Google Search Console (service account JSON path)
GOOGLE_APPLICATION_CREDENTIALS=./gsc-service-account.json

# Upstash Redis (for BullMQ job queue)
UPSTASH_REDIS_URL=your_redis_url

# Environment
NODE_ENV=development
